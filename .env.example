SMARTLIB_ENV=development
# Enable staff MFA during local testing; production always requires it.
SMARTLIB_REQUIRE_STAFF_MFA=false
# Generate a unique random value for each deployment; required in production.
SMARTLIB_SECRET_KEY=
# Separate key for encryption of MFA seeds; Render generates this in production.
SMARTLIB_MFA_ENCRYPTION_KEY=
# Automatic encrypted off-site backup is opt-in. Configure a private S3-compatible
# bucket, separate encryption key, and approved retention period before enabling.
SMARTLIB_BACKUP_ENABLED=false
SMARTLIB_BACKUP_DIR=./backups
SMARTLIB_BACKUP_INTERVAL_HOURS=24
SMARTLIB_BACKUP_RETENTION_DAYS=
SMARTLIB_BACKUP_S3_BUCKET=
SMARTLIB_BACKUP_S3_REGION=
SMARTLIB_BACKUP_S3_ACCESS_KEY_ID=
SMARTLIB_BACKUP_S3_SECRET_ACCESS_KEY=
# Optional for an S3-compatible provider other than AWS; must use HTTPS.
SMARTLIB_BACKUP_S3_ENDPOINT_URL=
SMARTLIB_BACKUP_S3_PREFIX=smartlib
# Keep separate from both app signing and MFA keys; do not commit or store beside backups.
SMARTLIB_BACKUP_ENCRYPTION_KEY=

# Set this to the URL users open. Production URLs must use HTTPS.
#PUBLIC_BASE_URL=http://127.0.0.1:8000
PUBLIC_BASE_URL=http://192.168.254.104:8000
PUBLIC_BASE_URL=https://7369-2001-fd8-e616-5e00-588c-fe0c-7a4b-634b.ngrok-free.app
#PUBLIC_BASE_URL=https://1198-2001-fd8-e61b-2800-ec97-d6d0-301a-e66a.ngrok-free.app
# Email delivery is required for verification and password reset; see EMAIL-SETUP.md.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_USE_SSL=false

# Set true only after HTTPS is configured at the app server or reverse proxy.
REQUIRE_HTTPS=false
# Comma-separated exact browser origins, only needed for a separate web frontend.
CORS_ALLOWED_ORIGINS=

# Server-side AI assistant (restart FastAPI after configuring).
OPENAI_API_KEY=
SMARTLIB_AI_MODEL=gpt-5-mini

# Use brevo for HTTPS email delivery on Render Free; SMTP remains the local default.
EMAIL_PROVIDER=smtp
BREVO_API_KEY=
# For Brevo, set SMTP_FROM to the sender verified in your Brevo account.
