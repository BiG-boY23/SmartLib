{
  "expo": {
    "name": "EVSU SmartLib",
    "slug": "evsu-smartlib-mobile",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f3ead0"
    },
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": ["expo-secure-store"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ph.edu.evsu.smartlib",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Connect to the EVSU SmartLib server on your local network.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "ph.edu.evsu.smartlib",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#f3ead0"
      },
      "usesCleartextTraffic": true
    }
  }
}
